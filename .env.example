# Local-only demo credentials. Copy this file to .env before running Compose.
# These values are intentionally non-production. Replace every password and secret
# before using the stack outside an isolated local workstation.
POSTGRES_SUPERUSER=reservation_admin
POSTGRES_SUPERUSER_PASSWORD=local-postgres-admin-password
ORDERS_DB_USERNAME=orders
ORDERS_DB_PASSWORD=local-orders-db-password
INVENTORY_DB_USERNAME=inventory
INVENTORY_DB_PASSWORD=local-inventory-db-password
KEYCLOAK_DB_USERNAME=keycloak
KEYCLOAK_DB_PASSWORD=local-keycloak-db-password
KEYCLOAK_ADMIN_USERNAME=admin
KEYCLOAK_ADMIN_PASSWORD=local-keycloak-admin-password
ORDERS_DEMO_CLIENT_SECRET=local-orders-client-secret
INVENTORY_DEMO_CLIENT_SECRET=local-inventory-client-secret
MONITORING_CLIENT_SECRET=local-monitoring-client-secret

# Browser tokens use the host issuer; services may fetch keys over the container network.
SECURITY_ISSUER_URI=http://localhost:8180/realms/reservation
SECURITY_JWK_SET_URI=http://keycloak:8080/realms/reservation/protocol/openid-connect/certs
