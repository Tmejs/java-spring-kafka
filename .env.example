# Local demo service-account secrets. Replace these values in .env.
ORDERS_DEMO_CLIENT_SECRET=replace-with-a-long-random-orders-secret
INVENTORY_DEMO_CLIENT_SECRET=replace-with-a-long-random-inventory-secret
MONITORING_CLIENT_SECRET=replace-with-a-long-random-monitoring-secret

# Browser tokens use the host issuer; services may fetch keys over the container network.
SECURITY_ISSUER_URI=http://localhost:8180/realms/reservation
SECURITY_JWK_SET_URI=http://keycloak:8080/realms/reservation/protocol/openid-connect/certs
